#!/usr/bin/env bash
# Pre-push hook: runs lint checks before allowing push.
# Install with: make install-hooks

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"

echo "=== Pre-push: running lint checks ==="

# --- Frontend ---
echo ">> Frontend: ESLint"
(cd "$ROOT/frontend" && npm run lint)

echo ">> Frontend: TypeScript check"
(cd "$ROOT/frontend" && npx tsc --noEmit)

# --- Backend ---
echo ">> Backend: go vet"
(cd "$ROOT/backend" && go vet ./...)

# `go install` drops the binary in GOBIN, falling back to GOPATH/bin — neither is
# guaranteed to be on PATH (with mise, GOBIN points inside the toolchain install
# dir). Resolve it explicitly rather than trusting the caller's PATH, otherwise
# the install below succeeds and the very next line reports "command not found".
GO_BIN_DIR="$(go env GOBIN)"
[ -n "$GO_BIN_DIR" ] || GO_BIN_DIR="$(go env GOPATH)/bin"
export PATH="$GO_BIN_DIR:$PATH"

if ! command -v golangci-lint &>/dev/null; then
    echo ">> Backend: golangci-lint not found, installing..."
    go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@latest
fi

echo ">> Backend: golangci-lint"
(cd "$ROOT/backend" && golangci-lint run ./...)

echo "=== All lint checks passed ==="
