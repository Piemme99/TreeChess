# =============================================================================
# TreeChess Production Environment Variables
# =============================================================================
# Copy this file to .env.production and fill in all values.
# NEVER commit .env.production to version control.
# =============================================================================

# --- Database ---
POSTGRES_USER=treechess
POSTGRES_PASSWORD=          # Strong random password (32+ chars recommended)

# --- Authentication ---
JWT_SECRET=                 # Strong random secret (32+ chars, e.g. openssl rand -hex 32)
SECURE_COOKIES=true

# --- URLs ---
CORS_ALLOWED_ORIGINS=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com

# --- Lichess OAuth ---
LICHESS_CLIENT_ID=
LICHESS_CLIENT_SECRET=
OAUTH_CALLBACK_URL=https://yourdomain.com/api/auth/lichess/callback

# --- SMTP (Email) ---
SMTP_HOST=                  # e.g. smtp.mailgun.org, smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@yourdomain.com
