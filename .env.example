# Database
POSTGRES_USER=treechess
POSTGRES_PASSWORD=change-me-to-a-secure-password
POSTGRES_DB=treechess
DATABASE_URL=postgres://treechess:PASSWORD@localhost:5432/treechess?sslmode=disable

# Server
PORT=8080

# Authentication
# JWT_SECRET signs access tokens and seeds the OAuth cookie encryption key.
# In production it MUST be at least 32 bytes (256 bits); shorter secrets are
# rejected at startup. Generate one with e.g. `openssl rand -base64 48`.
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRY_HOURS=168

# OAuth (Lichess)
LICHESS_CLIENT_ID=your-lichess-client-id
OAUTH_CALLBACK_URL=http://localhost:8080/api/auth/lichess/callback

# Lichess Opening Explorer (Training tab)
# The endpoint is gated by Lichess; each authenticated user's OAuth token is
# forwarded for cache misses. The cache TTL keeps shared positions warm so we
# don't burn user tokens on common openings.
LICHESS_EXPLORER_BASE_URL=https://explorer.lichess.org
LICHESS_EXPLORER_CACHE_TTL_HOURS=168

# Frontend
FRONTEND_URL=http://localhost:5173
# Comma-separated list of allowed CORS origins. Requests are sent with
# credentials, so a wildcard "*" is rejected at startup (forbidden by the Fetch
# spec when credentials are enabled) — list exact origins instead.
CORS_ALLOWED_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8080

# Security
# Must be set to "true" in production (served over HTTPS); the server refuses to
# start in production when this is false, since the long-lived refresh cookie and
# the OAuth-state cookie would otherwise be transmitted over plain HTTP.
SECURE_COOKIES=false

# Deployment note: rate limiting and request logging key on the client IP via
# X-Forwarded-For. Always run behind a reverse proxy that strips any
# client-supplied X-Forwarded-For header before setting its own; exposing the app
# directly lets clients spoof their IP and bypass the rate limiter.

# Email (Mailhog for development)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM_ADDRESS=noreply@treechess.local
# SMTP_USER=        # Not needed for Mailhog
# SMTP_PASSWORD=    # Not needed for Mailhog

# Monitoring
GRAFANA_ADMIN_PASSWORD=admin
