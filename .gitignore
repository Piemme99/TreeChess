# Dependencies — no trailing slash: that would only match directories, and a
# node_modules symlink slipped past the old rule and got committed (see the
# commit that removed it).
node_modules

# Build outputs
dist/
build/

# Environment files
.env
.env.production
.env.local
.env.*.local

# Let's Encrypt certificates (generated on VPS)
certbot/

# Database backups (generated on VPS)
backups/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Go
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/
testbinary/
tmp/
backend/server

# Generated files
*.generated.*
games.pgn

# Lighthouse reports
lighthouse-report*

# Session-local notes (workflow feedback, scratchpads)
.notes/

# Sandcastle orchestration artefacts (npm install + worktrees + logs + env)
.sandcastle/
